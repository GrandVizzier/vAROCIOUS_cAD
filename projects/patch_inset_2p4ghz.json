{
  "name": "patch_inset_2p4ghz",
  "units": "mm",
  "description": "2.4 GHz inset-fed rectangular patch on 1.6 mm FR4, 50 ohm microstrip feed, lumped port, radiation air box",
  "variables": {
    "f0": "2.4e9",
    "er": "4.4",
    "h": "1.6",
    "Z0": "50",
    "lam0": "c0/f0*1000",
    "W": "c0/(2*f0)*sqrt(2/(er+1))*1000",
    "eeff": "(er+1)/2 + (er-1)/2*(1+12*h/W)**-0.5",
    "dL": "0.412*h*(eeff+0.3)*(W/h+0.264)/((eeff-0.258)*(W/h+0.8))",
    "L": "c0/(2*f0*sqrt(eeff))*1000 - 2*dL",
    "G1": "W/(120*lam0)",
    "R_edge": "1/(2*G1)",
    "y0": "L/pi*acos(sqrt(Z0/R_edge))",
    "A": "Z0/60*sqrt((er+1)/2) + (er-1)/(er+1)*(0.23+0.11/er)",
    "wf": "h*8*exp(A)/(exp(2*A)-2)",
    "g": "1",
    "margin": "lam0/8",
    "sub_w": "W + 2*margin",
    "sub_l": "L + 2*margin",
    "pad": "lam0/4 + 5",
    "mesh_size": "lam0/10"
  },
  "history": [
    { "op": "box", "name": "substrate", "origin": ["-sub_w/2", "-sub_l/2", "0"],
      "size": ["sub_w", "sub_l", "h"], "material": "FR4" },
    { "op": "rectangle", "name": "ground", "origin": ["-sub_w/2", "-sub_l/2", "0"],
      "size": ["sub_w", "sub_l"], "plane": "XY", "material": "PEC" },
    { "op": "rectangle", "name": "patch", "origin": ["-W/2", "-L/2", "h"],
      "size": ["W", "L"], "plane": "XY", "material": "PEC" },
    { "op": "rectangle", "name": "notch", "origin": ["-wf/2-g", "-L/2", "h"],
      "size": ["wf+2*g", "y0"], "plane": "XY", "material": "PEC" },
    { "op": "subtract", "object": "patch", "tools": ["notch"] },
    { "op": "rectangle", "name": "feed", "origin": ["-wf/2", "-sub_l/2", "h"],
      "size": ["wf", "sub_l/2 - L/2 + y0"], "plane": "XY", "material": "PEC" },
    { "op": "unite", "object": "patch", "tools": ["feed"] },
    { "op": "rectangle", "name": "port1", "origin": ["-wf/2", "-sub_l/2", "0"],
      "size": ["wf", "h"], "plane": "XZ", "material": "port" },
    { "op": "box", "name": "airbox", "origin": ["-sub_w/2-pad", "-sub_l/2-pad", "-pad"],
      "size": ["sub_w+2*pad", "sub_l+2*pad", "h+2*pad"], "material": "air" }
  ],
  "boundaries": [ { "type": "radiation", "target": "airbox", "faces": "outer" } ],
  "ports": [ { "target": "port1", "type": "lumped", "impedance": "Z0", "direction": "+z" } ],
  "simulation": {
    "solver": "openems",
    "sweep": { "start": "2.0e9", "stop": "2.8e9", "points": 401 },
    "fields_at": ["f0"]
  }
}
